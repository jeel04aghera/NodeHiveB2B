# Copy to .env. Dev defaults match deploy/docker-compose.yml and `make dev`.

# --- Mode ---
# development = seed DEV_* admin/token + allow a weak JWT_SECRET. Anything else (or
# unset) = production: dev bootstrap disabled and a strong JWT_SECRET is REQUIRED.
ENV=development

# --- Database ---
DATABASE_URL=postgres://gpu:gpu@localhost:5432/gpu?sslmode=disable

# --- Control plane listeners ---
HTTP_ADDR=:8080            # REST API for the frontend
GRPC_ADDR=:9090            # Agent gateway (gRPC)
GRPC_INSECURE=true         # dev only: serve gRPC without TLS

# --- Dev enrollment (so `make agent` works out of the box) ---
DEV_ORG_SLUG=dev
DEV_ENROLLMENT_TOKEN=dev-enroll-token   # control plane seeds this token on startup

# --- Auth ---
JWT_SECRET=dev-only-change-me
SESSION_TTL=24h            # legacy single-token TTL; also the access-token fallback
ACCESS_TOKEN_TTL=15m       # short-lived Bearer access token (Phase 2). Unset => SESSION_TTL
REFRESH_TOKEN_TTL=720h     # long-lived refresh-token session (Phase 2; 720h = 30 days)
DEV_BOOTSTRAP_ADMIN=admin@local:admin123   # reserved for T-006 (auth); unused in this slice

# Cross-origin cookie auth (Phase 2). In production set an explicit allow-list (no wildcard);
# the refresh cookie is then sent with credentials. Local dev (ENV=development) reflects the
# request origin automatically, so this can stay unset for localhost:3000 → :8080.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Agent (cmd/agent) ---
AGENT_SERVER_URL=localhost:9090
AGENT_ENROLLMENT_TOKEN=dev-enroll-token
AGENT_CREDENTIAL_PATH=./.gpu-agent/credential.json
AGENT_INSECURE=true        # dev only: skip TLS/pinned-CA
HEARTBEAT_INTERVAL=30s
AGENT_DEV_MODE=false        # true (or --dev): synthetic GPU inventory/metrics for a box w/o NVIDIA
AGENT_GPU_PASSTHROUGH=true  # add --gpus to docker run; auto-forced false under --dev
AGENT_ADVERTISE_HOST=       # host shown in SSH/Jupyter endpoints; empty=hostname, --dev=localhost

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
